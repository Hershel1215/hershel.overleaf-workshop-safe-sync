          "group": "inline@1"
        },
        {
          "command": "hershel.overleaf-workshop-safe-sync.projectManager.trashProject",
          "when": "view == hershel.overleaf-workshop-safe-sync.projectManager && viewItem =~ /^(?!trashed).*project/",
