{
  "name": "overleaf-workshop-safe-sync",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "1.0.0-hershel.20",
  "hershelBuildId": "20260731T035525Z-safe-sync-rc20",
  "icon": "resources/icons/app_icon.png",
  "author": {
    "name": "iamhyc",
    "email": "ychong@petalmail.com"
  },
  "publisher": "hershel",
  "contributors": [
    {
      "name": "iamhyc",
      "email": "ychong@petalmail.com",
      "url": "https://github.com/iamhyc"
    },
    {
      "name": "QianrenLi",
      "email": "liqr2022@mail.sustech.edu.cn",
      "url": "https://github.com/QianrenLi"
    },
    {
      "name": "Mingbo-Lee",
      "url": "https://github.com/Mingbo-Lee"
    },
    {
      "name": "zeyugao",
      "url": "https://github.com/zeyugao"
    },
    {
      "name": "LaureatePoet",
      "url": "https://github.com/LaureatePoet"
    },
    {
      "name": "akretz",
      "url": "https://github.com/akretz"
    },
    {
      "name": "JRodez",
      "url": "https://github.com/JRodez"
    },
    {
      "name": "riccardogibello",
      "url": "https://github.com/riccardogibello"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/overleaf-workshop/overleaf-workshop"
  },
  "bugs": {
    "url": "https://github.com/overleaf-workshop/overleaf-workshop/issues"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onFileSystem:overleaf-workshop",
    "workspaceContains:.overleaf/settings.json"
  ],
  "main": "./out/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "languages": [
      {
        "id": "tex",
        "aliases": [
          "TeX",
          "tex"
        ],
        "extensions": [
          ".sty",
          ".cls",
          ".bbx",
          ".cbx"
        ],
        "configuration": "data/vendor/languages/latex-language-configuration.json"
      },
      {
        "id": "latex",
        "aliases": [
          "LaTeX",
          "latex"
        ],
        "extensions": [
          ".tex",
          ".ltx",
          ".ctx"
        ],
        "configuration": "data/vendor/languages/latex-language-configuration.json"
      },
      {
        "id": "bibtex",
        "aliases": [
          "BibTeX",
          "bibtex"
        ],
        "extensions": [
          ".bib"
        ]
      },
      {
        "id": "cpp_embedded_latex",
        "configuration": "data/vendor/languages/latex-cpp-embedded-language-configuration.json",
        "aliases": []
      },
      {
        "id": "markdown_latex_combined",
        "configuration": "data/vendor/languages/markdown-latex-combined-language-configuration.json",
        "aliases": []
      }
    ],
    "commands": [
      {
        "command": "hershel.overleaf-workshop-safe-sync.remoteFileSystem.refreshLinkedFile",
        "title": "%commands.remoteFileSystem.refreshLinkedFile.title%",
        "icon": "$(refresh)",
        "enablement": "focusedView == 'workbench.explorer.fileView' && (resourceScheme == overleaf-workshop || hershel.overleaf-workshop-safe-sync.activate)",
        "category": "%extension.displayName%"
      },
      {
        "command": "hershel.overleaf-workshop-safe-sync.remoteFileSystem.createLinkedFile",
        "title": "%commands.remoteFileSystem.createLinkedFile.title%",
        "enablement": "resourceScheme == overleaf-workshop || hershel.overleaf-workshop-safe-sync.activate",
        "category": "%extension.displayName%"
      },
      {
        "command": "hershel.overleaf-workshop-safe-sync.projectManager.addServer",
        "title": "%commands.projectManager.addServer.title%",
        "icon": "$(add)",
        "category": "%extension.displayName%"
      },
      {
        "command": "hershel.overleaf-workshop-safe-sync.projectManager.removeServer",
        "title": "%commands.projectManager.removeServer.title%",
        "icon": "$(trash)",
        "enablement": "viewItem == server_login || viewItem == server_no_login",
        "category": "%extension.displayName%"
      },
      {
        "command": "hershel.overleaf-workshop-safe-sync.projectManager.loginServer",
        "title": "%commands.projectManager.loginServer.title%",
        "icon": "$(log-in)",
        "enablement": "viewItem == server_no_login",
        "category": "%extension.displayName%"
      },
      {
        "command": "hershel.overleaf-workshop-safe-sync.projectManager.logoutServer",
        "title": "%commands.projectManager.logoutServer.title%",
        "icon": "$(debug-disconnect)",
        "enablement": "viewItem == server_login",
        "category": "%extension.displayName%"
      },
      {
        "command": "hershel.overleaf-workshop-safe-sync.projectManager.refreshServer",
        "title": "%commands.projectManager.refreshServer.title%",
        "icon": "$(refresh)",
        "enablement": "viewItem == server_login",
        "category": "%extension.displayName%"
      },
      {
        "command": "hershel.overleaf-workshop-safe-sync.projectManager.newProject",
        "title": "%commands.projectManager.newProject.title%",
        "icon": "$(add)",
        "enablement": "viewItem == server_login",
        "category": "%extension.displayName%"
      },
      {
        "command": "hershel.overleaf-workshop-safe-sync.projectManager.copyProject",
        "title": "%commands.projectManager.copyProject.title%",
        "enablement": "viewItem =~ /^(?!archived).*project/",
        "category": "%extension.displayName%"
      },
      {
        "command": "hershel.overleaf-workshop-safe-sync.projectManager.renameProject",
        "title": "%commands.projectManager.renameProject.title%",
        "icon": "$(edit)",
        "enablement": "viewItem =~ /^(?!archived).*project/",
        "category": "%extension.displayName%"
      },
      {
        "command": "hershel.overleaf-workshop-safe-sync.projectManager.deleteProject",
        "title": "%commands.projectManager.deleteProject.title%",
        "icon": "$(circle-slash)",
        "enablement": "viewItem == trashed_project",
        "category": "%extension.displayName%"
      },
      {
        "command": "hershel.overleaf-workshop-safe-sync.projectManager.archiveProject",
        "title": "%commands.projectManager.archiveProject.title%",
        "icon": "$(archive)",
        "enablement": "viewItem =~ /^(?!archived).*project/",
        "category": "%extension.displayName%"
      },
      {
        "command": "hershel.overleaf-workshop-safe-sync.projectManager.unarchiveProject",
        "title": "%commands.projectManager.unarchiveProject.title%",
        "icon": "$(reply)",
        "enablement": "viewItem == archived_project",
        "category": "%extension.displayName%"
      },
      {
        "command": "hershel.overleaf-workshop-safe-sync.projectManager.trashProject",
        "title": "%commands.projectManager.trashProject.title%",
        "icon": "$(trash)",
        "enablement": "viewItem =~ /^(?!trashed).*project/",
        "category": "%extension.displayName%"
      },
      {
        "command": "hershel.overleaf-workshop-safe-sync.projectManager.untrashProject",
        "title": "%commands.projectManager.untrashProject.title%",
        "icon": "$(reply)",
        "enablement": "viewItem == trashed_project",
        "category": "%extension.displayName%"
      },
      {
        "command": "hershel.overleaf-workshop-safe-sync.projectManager.createTag",
        "title": "%commands.projectManager.createTag.title%",
        "icon": "$(tag)",
        "enablement": "viewItem == server_login",
        "category": "%extension.displayName%"
      },
      {
        "command": "hershel.overleaf-workshop-safe-sync.projectManager.renameTag",
        "title": "%commands.projectManager.renameTag.title%",
        "icon": "$(edit)",
        "enablement": "viewItem == tag",
        "category": "%extension.displayName%"
      },
      {
        "command": "hershel.overleaf-workshop-safe-sync.projectManager.deleteTag",
        "title": "%commands.projectManager.deleteTag.title%",
        "icon": "$(close-all)",
        "enablement": "viewItem == tag",
        "category": "%extension.displayName%"
      },
      {
        "command": "hershel.overleaf-workshop-safe-sync.projectManager.addProjectToTag",
        "title": "%commands.projectManager.addProjectToTag.title%",
        "icon": "$(tag)",
        "enablement": "viewItem == project",
        "category": "%extension.displayName%"
      },
      {
        "command": "hershel.overleaf-workshop-safe-sync.projectManager.removeProjectFromTag",
        "title": "%commands.projectManager.removeProjectFromTag.title%",
        "enablement": "viewItem == project_in_tag",
        "category": "%extension.displayName%"
      },
      {
        "command": "hershel.overleaf-workshop-safe-sync.projectManager.openProjectInCurrentWindow",
        "title": "%commands.projectManager.openProjectInCurrentWindow.title%",
        "icon": "$(arrow-right)",
        "enablement": "viewItem == project || viewItem == project_in_tag",
        "category": "%extension.displayName%"
      },
      {
        "command": "hershel.overleaf-workshop-safe-sync.projectManager.openProjectInNewWindow",
        "title": "%commands.projectManager.openProjectInNewWindow.title%",
        "icon": "$(empty-window)",
        "enablement": "viewItem == project || viewItem == project_in_tag",
        "category": "%extension.displayName%"
      },
      {
        "command": "hershel.overleaf-workshop-safe-sync.projectManager.openProjectLocalReplica",
        "title": "%commands.projectManager.openProjectLocalReplica.title%",
        "icon": "$(file-directory)",
        "enablement": "viewItem == project || viewItem == project_in_tag",
        "category": "%extension.displayName%"
      },
      {
        "command": "hershel.overleaf-workshop-safe-sync.projectHistory.refresh",
        "title": "%commands.projectHistory.refresh.title%",
        "icon": "$(refresh)",
        "enablement": "resourceScheme == overleaf-workshop",
        "category": "%extension.displayName%"
      },
      {
        "command": "hershel.overleaf-workshop-safe-sync.projectHistory.clearSelection",
        "title": "%commands.projectHistory.clearSelection.title%",
        "icon": "$(clear-all)",
        "enablement": "view == hershel.overleaf-workshop-safe-sync.projectHistory",
        "category": "%extension.displayName%"
      },
      {
        "command": "hershel.overleaf-workshop-safe-sync.projectHistory.createLabel",
        "title": "%commands.projectHistory.createLabel.title%",
        "icon": "$(tag)",
        "enablement": "viewItem =~ /historyItem(Labelled)?/",
        "category": "%extension.displayName%"
      },
      {
        "command": "hershel.overleaf-workshop-safe-sync.projectHistory.deleteLabel",
        "title": "%commands.projectHistory.deleteLabel.title%",
        "icon": "$(close-all)",
        "enablement": "viewItem == historyItemLabelled",
        "category": "%extension.displayName%"
      },
      {
        "command": "hershel.overleaf-workshop-safe-sync.projectHistory.comparePrevious",
        "title": "%commands.projectHistory.comparePrevious.title%",
        "enablement": "viewItem =~ /historyItem(Labelled)?/",
        "category": "%extension.displayName%"
      },
      {
        "command": "hershel.overleaf-workshop-safe-sync.projectHistory.compareCurrent",
        "title": "%commands.projectHistory.compareCurrent.title%",
        "enablement": "viewItem =~ /historyItem(Labelled)?/",
        "category": "%extension.displayName%"
      },
      {
        "command": "hershel.overleaf-workshop-safe-sync.projectHistory.compareOthers",
        "title": "%commands.projectHistory.compareOthers.title%",
        "enablement": "viewItem =~ /historyItem(Labelled)?/",
        "category": "%extension.displayName%"
      },
      {
        "command": "hershel.overleaf-workshop-safe-sync.projectHistory.downloadProject",
        "title": "%commands.projectHistory.downloadProject.title%",
        "icon": "$(cloud-download)",
        "enablement": "viewItem =~ /historyItem(Labelled)?/",
        "category": "%extension.displayName%"
      },
      {
        "command": "hershel.overleaf-workshop-safe-sync.projectHistory.revealHistoryView",
        "title": "%commands.projectHistory.revealHistoryView.title%",
        "enablement": "resourceScheme == overleaf-workshop",
        "category": "%extension.displayName%"
      },
      {
        "command": "hershel.overleaf-workshop-safe-sync.projectSCM.configSCM",
        "title": "%commands.projectSCM.configSCM.title%",
        "icon": "$(gear)",
        "enablement": "resourceScheme == overleaf-workshop || hershel.overleaf-workshop-safe-sync.activate",
        "category": "%extension.displayName%"
      },
      {
        "command": "hershel.overleaf-workshop-safe-sync.compileManager.compile",
        "title": "%commands.compileManager.compile.title%",
        "icon": "$(debug-start)",
        "enablement": "(resourceScheme == overleaf-workshop || hershel.overleaf-workshop-safe-sync.activateCompile) && resourceExtname == .tex",
        "category": "%extension.displayName%"
      },
      {
        "command": "hershel.overleaf-workshop-safe-sync.compileManager.viewPdf",
        "title": "%commands.compileManager.viewPdf.title%",
        "icon": "$(open-preview)",
        "enablement": "(resourceScheme == overleaf-workshop || hershel.overleaf-workshop-safe-sync.activateCompile) && resourceExtname == .tex",
        "category": "%extension.displayName%"
      },
      {
        "command": "hershel.overleaf-workshop-safe-sync.compileManager.syncCode",
        "title": "%commands.compileManager.syncCode.title%",
        "enablement": "editorTextFocus && (resourceScheme == overleaf-workshop || hershel.overleaf-workshop-safe-sync.activateCompile) && resourceExtname == .tex",
        "category": "%extension.displayName%"
      },
      {
        "command": "hershel.overleaf-workshop-safe-sync.compileManager.setCompiler",
        "title": "%commands.compileManager.setCompiler.title%",
        "enablement": "resourceScheme == overleaf-workshop || hershel.overleaf-workshop-safe-sync.activateCompile",
        "category": "%extension.displayName%"
      },
      {
        "command": "hershel.overleaf-workshop-safe-sync.compileManager.setRootDoc",
        "title": "%commands.compileManager.setRootDoc.title%",
        "enablement": "resourceScheme == overleaf-workshop || hershel.overleaf-workshop-safe-sync.activateCompile",
        "category": "%extension.displayName%"
      },
      {
        "command": "hershel.overleaf-workshop-safe-sync.collaboration.copyLineRef",
        "title": "%commands.collaboration.copyLineRef.title%",
        "enablement": "editorTextFocus && resourceScheme == overleaf-workshop",
        "category": "%extension.displayName%"
      },
      {
        "command": "hershel.overleaf-workshop-safe-sync.collaboration.insertLineRef",
        "title": "%commands.collaboration.insertLineRef.title%",
        "enablement": "editorTextFocus && resourceScheme == overleaf-workshop",
        "category": "%extension.displayName%"
      },
      {
        "command": "hershel.overleaf-workshop-safe-sync.collaboration.revealChatView",
        "title": "%commands.collaboration.revealChatView.title%",
        "enablement": "resourceScheme == overleaf-workshop || hershel.overleaf-workshop-safe-sync.activate",
        "category": "%extension.displayName%"
      },
      {
        "command": "hershel.overleaf-workshop-safe-sync.collaboration.jumpToUser",
        "title": "%commands.collaboration.jumpToUser.title%",
        "enablement": "resourceScheme == overleaf-workshop || hershel.overleaf-workshop-safe-sync.activate",
        "category": "%extension.displayName%"
      },
      {
        "command": "hershel.overleaf-workshop-safe-sync.safeSync.runE2E",
        "title": "Run Approved Safe Sync E2E",
        "category": "%extension.displayName%"
      }
    ],
    "keybindings": [
      {
        "key": "ctrl+alt+b",
        "mac": "cmd+alt+b",
        "command": "hershel.overleaf-workshop-safe-sync.compileManager.compile",
        "when": "editorTextFocus && (resourceScheme == overleaf-workshop || hershel.overleaf-workshop-safe-sync.activateCompile) && resourceExtname == .tex"
      },
      {
        "key": "ctrl+alt+v",
        "mac": "cmd+alt+v",
        "command": "hershel.overleaf-workshop-safe-sync.compileManager.viewPdf",
        "when": "editorTextFocus && (resourceScheme == overleaf-workshop || hershel.overleaf-workshop-safe-sync.activateCompile) && resourceExtname == .tex"
      },
      {
        "key": "ctrl+alt+j",
        "mac": "cmd+alt+j",
        "command": "hershel.overleaf-workshop-safe-sync.compileManager.syncCode",
        "when": "editorTextFocus && (resourceScheme == overleaf-workshop || hershel.overleaf-workshop-safe-sync.activateCompile) && resourceExtname == .tex"
      },
      {
        "key": "ctrl+shift+c",
        "mac": "cmd+shift+c",
        "command": "hershel.overleaf-workshop-safe-sync.collaboration.copyLineRef",
        "when": "editorTextFocus && resourceScheme == overleaf-workshop"
      }
    ],
    "configuration": {
      "title": "%extension.displayName%",
      "properties": {
        "hershel.overleaf-workshop-safe-sync.compileOnSave.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "markdownDescription": "%configuration.compileOnSave.enabled.markdownDescription%"
        },
        "hershel.overleaf-workshop-safe-sync.compileOutputFolderName": {
          "type": "string",
          "default": ".output",
          "scope": "machine",
          "pattern": "^[^\\\\/:*?\"<>|]+$",
          "markdownDescription": "%configuration.compileOutputFolderName.markdownDescription%"
        },
        "hershel.overleaf-workshop-safe-sync.pdfViewer.themes": {
          "type": "object",
          "default": {
            "default": {
              "fontColor": "#000000",
              "bgColor": "#FFFFFF"
            },
            "light": {
              "fontColor": "#000000",
              "bgColor": "#F5F5DC"
            },
            "dark": {
              "fontColor": "#FBF0D9",
              "bgColor": "#4B4B4B"
            }
          },
          "patternProperties": {
            "^[a-zA-Z0-9_-]+$": {
              "type": "object",
              "description": "%configuration.pdfViewer.themes.theme.description%",
              "properties": {
                "fontColor": {
                  "type": "string",
                  "format": "color",
                  "description": "%configuration.pdfViewer.themes.fontColor.description%"
                },
                "bgColor": {
                  "type": "string",
                  "format": "color",
                  "description": "%configuration.pdfViewer.themes.backgroundColor.description%"
                }
              }
            }
          },
          "additionalProperties": false,
          "scope": "machine",
          "markdownDescription": "%configuration.pdfViewer.themes.markdownDescription%"
        },
        "hershel.overleaf-workshop-safe-sync.pdfViewer.defaultScrollMode": {
          "type": "string",
          "enum": [
            "vertical",
            "horizontal",
            "wrapped",
            "page"
          ],
          "default": "vertical",
          "scope": "machine",
          "markdownDescription": "%configuration.pdfViewer.defaultScrollMode.markdownDescription%"
        },
        "hershel.overleaf-workshop-safe-sync.pdfViewer.defaultSpreadMode": {
          "type": "string",
          "enum": [
            "none",
            "odd",
            "even"
          ],
          "default": "none",
          "scope": "machine",
          "markdownDescription": "%configuration.pdfViewer.defaultSpreadMode.markdownDescription%"
        },
        "hershel.overleaf-workshop-safe-sync.invisibleMode.historyRefreshInterval": {
          "type": "number",
          "default": 3,
          "scope": "machine",
          "minimum": 1,
          "maximum": 60,
          "markdownDescription": "%configuration.invisibleMode.historyRefreshInterval.markdownDescription%"
        },
        "hershel.overleaf-workshop-safe-sync.invisibleMode.chatMessageRefreshInterval": {
          "type": "number",
          "default": 3,
          "scope": "machine",
          "minimum": 1,
          "maximum": 60,
          "markdownDescription": "%configuration.invisibleMode.chatMessageRefreshInterval.markdownDescription%"
        },
        "hershel.overleaf-workshop-safe-sync.invisibleMode.inactiveTimeout": {
          "type": "number",
          "default": 180,
          "scope": "machine",
          "minimum": 10,
          "maximum": 3600,
          "markdownDescription": "%configuration.invisibleMode.inactiveTimeout.markdownDescription%"
        },
        "hershel.overleaf-workshop-safe-sync.formatWithLineBreak.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "markdownDescription": "%configuration.formatWithLineBreak.enabled.markdownDescription%"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "hershel-overleaf-workshop-safe-sync",
          "title": "%extension.displayName%",
          "icon": "resources/icons/overleaf_bw.svg"
        }
      ]
    },
    "views": {
      "hershel-overleaf-workshop-safe-sync": [
        {
          "id": "hershel.overleaf-workshop-safe-sync.projectManager",
          "name": "%views.hershel.overleaf-workshop-safe-sync.projectManager.name%"
        }
      ],
      "explorer": [
        {
          "id": "hershel.overleaf-workshop-safe-sync.projectHistory",
          "icon": "$(history)",
          "name": "%views.explorer.hershel.overleaf-workshop-safe-sync.projectHistory%",
          "contextualTitle": "%views.explorer.hershel.overleaf-workshop-safe-sync.contextualTitle%",
          "when": "resourceScheme == overleaf-workshop"
        },
        {
          "type": "webview",
          "id": "hershel.overleaf-workshop-safe-sync.chatWebview",
          "icon": "$(feedback)",
          "name": "%views.explorer.hershel.overleaf-workshop-safe-sync.chatWebview.name%",
          "contextualTitle": "%views.explorer.hershel.overleaf-workshop-safe-sync.chatWebview.contextualTitle%",
          "when": "resourceScheme == overleaf-workshop || hershel.overleaf-workshop-safe-sync.activate"
        }
      ]
    },
    "menus": {
      "explorer/context": [
        {
          "command": "hershel.overleaf-workshop-safe-sync.remoteFileSystem.refreshLinkedFile",
          "when": "(resourceScheme == overleaf-workshop || hershel.overleaf-workshop-safe-sync.activate) && !explorerResourceIsFolder"
        },
        {
          "command": "hershel.overleaf-workshop-safe-sync.remoteFileSystem.createLinkedFile",
          "when": "(resourceScheme == overleaf-workshop || hershel.overleaf-workshop-safe-sync.activate) && explorerResourceIsFolder"
        }
      ],
      "editor/context": [
        {
          "command": "hershel.overleaf-workshop-safe-sync.collaboration.copyLineRef",
          "when": "resourceScheme == overleaf-workshop || hershel.overleaf-workshop-safe-sync.activate"
        },
        {
          "command": "hershel.overleaf-workshop-safe-sync.collaboration.insertLineRef",
          "when": "resourceScheme == overleaf-workshop || hershel.overleaf-workshop-safe-sync.activate"
        }
      ],
      "view/title": [
        {
          "command": "hershel.overleaf-workshop-safe-sync.projectManager.addServer",
          "when": "view == hershel.overleaf-workshop-safe-sync.projectManager",
          "group": "navigation"
        },
        {
          "command": "hershel.overleaf-workshop-safe-sync.projectSCM.configSCM",
          "when": "view == hershel.overleaf-workshop-safe-sync.projectHistory",
          "group": "navigation@1"
        },
        {
          "command": "hershel.overleaf-workshop-safe-sync.projectHistory.refresh",
          "when": "view == hershel.overleaf-workshop-safe-sync.projectHistory",
          "group": "navigation@2"
        },
        {
          "command": "hershel.overleaf-workshop-safe-sync.projectHistory.clearSelection",
          "when": "view == hershel.overleaf-workshop-safe-sync.projectHistory",
          "group": "navigation@3"
        }
      ],
      "editor/title": [
        {
          "command": "hershel.overleaf-workshop-safe-sync.compileManager.compile",
          "when": "(resourceScheme == overleaf-workshop || hershel.overleaf-workshop-safe-sync.activateCompile) && resourceExtname == .tex",
          "group": "navigation@1"
        },
        {
          "command": "hershel.overleaf-workshop-safe-sync.compileManager.viewPdf",
          "when": "(resourceScheme == overleaf-workshop || hershel.overleaf-workshop-safe-sync.activateCompile) && resourceExtname == .tex",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "hershel.overleaf-workshop-safe-sync.projectManager.loginServer",
          "when": "view == hershel.overleaf-workshop-safe-sync.projectManager && viewItem == server_no_login",
          "group": "inline"
        },
        {
          "command": "hershel.overleaf-workshop-safe-sync.projectManager.newProject",
          "when": "view == hershel.overleaf-workshop-safe-sync.projectManager && viewItem == server_login",
          "group": "inline@1"
        },
        {
          "command": "hershel.overleaf-workshop-safe-sync.projectManager.refreshServer",
          "when": "view == hershel.overleaf-workshop-safe-sync.projectManager && viewItem == server_login",
          "group": "inline@2"
        },
        {
          "command": "hershel.overleaf-workshop-safe-sync.projectManager.logoutServer",
          "when": "view == hershel.overleaf-workshop-safe-sync.projectManager && viewItem == server_login",
