          "group": "2_scmActions@0"
        },
        {
          "command": "hershel.overleaf-workshop-safe-sync.projectHistory.compareOthers",
          "when": "view == hershel.overleaf-workshop-safe-sync.projectHistory && viewItem =~ /historyItem(Labelled)?/",
          "group": "2_scmActions@2"
        },
        {
          "command": "hershel.overleaf-workshop-safe-sync.projectHistory.downloadProject",
          "when": "view == hershel.overleaf-workshop-safe-sync.projectHistory && viewItem =~ /historyItem(Labelled)?/",
          "group": "z_downloadAction"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "hershel.overleaf-workshop-safe-sync.pdfViewer",
