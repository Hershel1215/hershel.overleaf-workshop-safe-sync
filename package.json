        },
        {
          "command": "hershel.overleaf-workshop-safe-sync.projectManager.removeServer",
          "when": "view == hershel.overleaf-workshop-safe-sync.projectManager && viewItem == server_login || viewItem == server_no_login"
        },
        {
          "command": "hershel.overleaf-workshop-safe-sync.projectManager.copyProject",
          "when": "view == hershel.overleaf-workshop-safe-sync.projectManager && viewItem =~ /^(?!archived).*project/",
          "group": "1_editActions"
        },
        {
          "command": "hershel.overleaf-workshop-safe-sync.projectManager.renameProject",
          "when": "view == hershel.overleaf-workshop-safe-sync.projectManager && viewItem =~ /^(?!archived).*project/",
          "group": "1_editActions"
        },
        {
          "command": "hershel.overleaf-workshop-safe-sync.projectManager.deleteProject",
          "when": "view == hershel.overleaf-workshop-safe-sync.projectManager && viewItem == trashed_project",
          "group": "inline@2"
        },
        {
          "command": "hershel.overleaf-workshop-safe-sync.projectManager.archiveProject",
          "when": "view == hershel.overleaf-workshop-safe-sync.projectManager && viewItem =~ /^(?!archived).*project/",
          "group": "1_editActions"
        },
        {
          "command": "hershel.overleaf-workshop-safe-sync.projectManager.unarchiveProject",
